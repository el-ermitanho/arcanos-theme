{
  "$schema": "vscode://schemas/color-theme",
  "name": "Arcanos · XVII La Estrella",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#7ee0e699",
    "foreground": "#e1eef2",
    "descriptionForeground": "#94b6c4",
    "errorForeground": "#ff7a85",
    "icon.foreground": "#94b6c4",
    "selection.background": "#7ee0e659",
    "widget.shadow": "#00000040",
    "textLink.foreground": "#7ee0e6",
    "textLink.activeForeground": "#7ee0e6",
    "textPreformat.foreground": "#9ee6b8",
    "textBlockQuote.background": "#13293a",
    "textBlockQuote.border": "#7ee0e6",
    "editor.background": "#0f2230",
    "editor.foreground": "#e1eef2",
    "editorLineNumber.foreground": "#94b6c48c",
    "editorLineNumber.activeForeground": "#7ee0e6",
    "editorCursor.foreground": "#7ee0e6",
    "editor.selectionBackground": "#7ee0e647",
    "editor.inactiveSelectionBackground": "#7ee0e624",
    "editor.selectionHighlightBackground": "#7ee0e629",
    "editor.wordHighlightBackground": "#c9b0ff29",
    "editor.wordHighlightStrongBackground": "#7ee0e633",
    "editor.findMatchBackground": "#7ee0e673",
    "editor.findMatchHighlightBackground": "#7ee0e638",
    "editor.lineHighlightBackground": "#1a3447b3",
    "editor.lineHighlightBorder": "#00000000",
    "editor.rangeHighlightBackground": "#7ee0e614",
    "editorWhitespace.foreground": "#94b6c440",
    "editorIndentGuide.background1": "#21405acc",
    "editorIndentGuide.activeBackground1": "#7ee0e680",
    "editorRuler.foreground": "#21405a",
    "editorBracketMatch.background": "#7ee0e633",
    "editorBracketMatch.border": "#7ee0e699",
    "editorBracketHighlight.foreground1": "#7ee0e6",
    "editorBracketHighlight.foreground2": "#a8d8ff",
    "editorBracketHighlight.foreground3": "#c9b0ff",
    "editorError.foreground": "#ff7a85",
    "editorWarning.foreground": "#ffcc66",
    "editorInfo.foreground": "#8fc7ff",
    "editorGutter.background": "#0f2230",
    "editorGutter.addedBackground": "#7fd99a",
    "editorGutter.modifiedBackground": "#8fb8ff",
    "editorGutter.deletedBackground": "#ff7a85",
    "editorWidget.background": "#13293a",
    "editorWidget.border": "#21405a",
    "editorSuggestWidget.background": "#13293a",
    "editorSuggestWidget.border": "#21405a",
    "editorSuggestWidget.selectedBackground": "#1a3447",
    "editorSuggestWidget.highlightForeground": "#7ee0e6",
    "editorHoverWidget.background": "#13293a",
    "editorHoverWidget.border": "#21405a",
    "editorGroupHeader.tabsBackground": "#0b1a25",
    "editorGroup.border": "#21405a",
    "editorOverviewRuler.border": "#00000000",
    "minimap.background": "#0f2230",
    "diffEditor.insertedTextBackground": "#7fd99a29",
    "diffEditor.removedTextBackground": "#ff7a8529",
    "tab.activeBackground": "#0f2230",
    "tab.activeForeground": "#e1eef2",
    "tab.activeBorderTop": "#7ee0e6",
    "tab.inactiveBackground": "#0b1a25",
    "tab.inactiveForeground": "#94b6c4",
    "tab.border": "#0b1a25",
    "tab.hoverBackground": "#13293a",
    "activityBar.background": "#0b1a25",
    "activityBar.foreground": "#7ee0e6",
    "activityBar.inactiveForeground": "#94b6c4bf",
    "activityBar.activeBorder": "#7ee0e6",
    "activityBarBadge.background": "#7ee0e6",
    "activityBarBadge.foreground": "#0f2230",
    "sideBar.background": "#0b1a25",
    "sideBar.foreground": "#e1eef2",
    "sideBar.border": "#21405a",
    "sideBarTitle.foreground": "#94b6c4",
    "sideBarSectionHeader.background": "#0b1a25",
    "sideBarSectionHeader.foreground": "#94b6c4",
    "list.activeSelectionBackground": "#1a3447",
    "list.activeSelectionForeground": "#e1eef2",
    "list.inactiveSelectionBackground": "#1a3447b3",
    "list.hoverBackground": "#1a34478c",
    "list.focusOutline": "#7ee0e699",
    "list.highlightForeground": "#7ee0e6",
    "statusBar.background": "#0b1a25",
    "statusBar.foreground": "#94b6c4",
    "statusBar.border": "#21405a",
    "statusBar.debuggingBackground": "#7ee0e6",
    "statusBar.debuggingForeground": "#0f2230",
    "statusBar.noFolderBackground": "#0b1a25",
    "statusBarItem.remoteBackground": "#7ee0e6",
    "statusBarItem.remoteForeground": "#0f2230",
    "titleBar.activeBackground": "#0b1a25",
    "titleBar.activeForeground": "#e1eef2",
    "titleBar.inactiveBackground": "#0b1a25",
    "titleBar.inactiveForeground": "#94b6c4",
    "titleBar.border": "#21405a",
    "panel.background": "#0b1a25",
    "panel.border": "#21405a",
    "panelTitle.activeBorder": "#7ee0e6",
    "panelTitle.activeForeground": "#e1eef2",
    "panelTitle.inactiveForeground": "#94b6c4",
    "breadcrumb.foreground": "#94b6c4",
    "breadcrumb.focusForeground": "#e1eef2",
    "button.background": "#7ee0e6",
    "button.foreground": "#0f2230",
    "button.hoverBackground": "#7ee0e6d9",
    "button.secondaryBackground": "#1a3447",
    "button.secondaryForeground": "#e1eef2",
    "badge.background": "#7ee0e6",
    "badge.foreground": "#0f2230",
    "input.background": "#13293a",
    "input.foreground": "#e1eef2",
    "input.border": "#21405a",
    "input.placeholderForeground": "#94b6c4cc",
    "inputOption.activeBorder": "#7ee0e6",
    "dropdown.background": "#13293a",
    "dropdown.border": "#21405a",
    "checkbox.background": "#13293a",
    "checkbox.border": "#21405a",
    "progressBar.background": "#7ee0e6",
    "scrollbarSlider.background": "#94b6c433",
    "scrollbarSlider.hoverBackground": "#94b6c452",
    "scrollbarSlider.activeBackground": "#7ee0e673",
    "notifications.background": "#13293a",
    "notifications.border": "#21405a",
    "quickInput.background": "#13293a",
    "pickerGroup.foreground": "#7ee0e6",
    "menu.background": "#13293a",
    "menu.selectionBackground": "#1a3447",
    "gitDecoration.addedResourceForeground": "#7fd99a",
    "gitDecoration.modifiedResourceForeground": "#8fb8ff",
    "gitDecoration.deletedResourceForeground": "#ff7a85",
    "gitDecoration.untrackedResourceForeground": "#9ee6b8",
    "gitDecoration.ignoredResourceForeground": "#94b6c499",
    "gitDecoration.conflictingResourceForeground": "#ffcc66",
    "terminal.background": "#0b1a25",
    "terminal.foreground": "#e1eef2",
    "terminalCursor.foreground": "#7ee0e6",
    "terminal.ansiBlack": "#0b1a25",
    "terminal.ansiRed": "#ff7a85",
    "terminal.ansiGreen": "#7fd99a",
    "terminal.ansiYellow": "#ffcc66",
    "terminal.ansiBlue": "#c9b0ff",
    "terminal.ansiMagenta": "#ffa68a",
    "terminal.ansiCyan": "#9ee6b8",
    "terminal.ansiWhite": "#e1eef2",
    "terminal.ansiBrightBlack": "#94b6c4",
    "terminal.ansiBrightRed": "#ff7a85",
    "terminal.ansiBrightGreen": "#7fd99a",
    "terminal.ansiBrightYellow": "#7ee0e6",
    "terminal.ansiBrightBlue": "#8fc7ff",
    "terminal.ansiBrightMagenta": "#a8d8ff",
    "terminal.ansiBrightCyan": "#9ee6b8",
    "terminal.ansiBrightWhite": "#ffffff"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6f97aa",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#ffd36e"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#b3cdd8"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9ee6b8"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ffc38a"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ffa68a"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ffc38a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#7ee0e6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#c9b0ff"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#e1eef2"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#e1eef2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language"
      ],
      "settings": {
        "foreground": "#ffd36e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#a8d8ff"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#ffd36e"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7ee0e6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#c9b0ff"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#ffc38a"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#7ee0e6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#7ee0e6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#a8d8ff",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#9ee6b8"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#c9b0ff",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7fd99a"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff7a85"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8fb8ff"
      }
    },
    {
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#a8d8ff"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff7a85"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": {
      "foreground": "#6f97aa",
      "italic": true
    },
    "keyword": "#ffd36e",
    "string": "#9ee6b8",
    "number": "#ffa68a",
    "function": "#7ee0e6",
    "method": "#7ee0e6",
    "class": "#c9b0ff",
    "interface": "#c9b0ff",
    "enum": "#c9b0ff",
    "type": "#c9b0ff",
    "typeParameter": "#c9b0ff",
    "namespace": "#c9b0ff",
    "variable": "#e1eef2",
    "variable.readonly": "#ffc38a",
    "parameter": {
      "foreground": "#e1eef2",
      "italic": true
    },
    "property": "#a8d8ff",
    "enumMember": "#ffc38a",
    "decorator": "#ffc38a",
    "macro": "#ffc38a"
  }
}
